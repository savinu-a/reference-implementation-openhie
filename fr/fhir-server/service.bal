            log:printDebug(string `${resourceType}: DELETE - Execution Success!`);
            sendAuditEvent(resourceType, id, "D", "delete", "0", "");
            return {
                resourceType: "OperationOutcome",
                issue: [
                    {
                        severity: "information",
                        code: "informational",
                        diagnostics: string `${resourceType}/${id} deleted successfully`
                    }
                ]
