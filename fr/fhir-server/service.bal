// Returns a 405 FHIRError when the given IHE transaction is disabled.
isolated function checkTransactionEnabled(boolean enabled, string transactionName) returns r4:FHIRError? {
    if !enabled {
        return r4:createFHIRError(
            string `IHE transaction ${transactionName} is disabled on this server`,
            r4:ERROR, r4:PROCESSING, httpStatusCode = http:STATUS_METHOD_NOT_ALLOWED
        );
    }
    return ();
}

